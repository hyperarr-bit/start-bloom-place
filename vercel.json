{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/vendas/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/vendas" }
      ]
    },
    {
      "source": "/vendas/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "redirects": [
    { "source": "/conhecer", "destination": "/vitalicio", "permanent": false },
    { "source": "/conhecer/", "destination": "/vitalicio", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vitalicio/demo", "destination": "/conhecer-demo.html" },
    { "source": "/vitalicio/demo/", "destination": "/conhecer-demo.html" },
    {
      "source": "/baixar",
      "destination": "/api/baixar"
    },
    {
      "source": "/missao",
      "destination": "/missao.html"
    },
    {
      "source": "/organizar",
      "destination": "/landing.html"
    },
    {
      "source": "/oferta",
      "destination": "/landing.html"
    },
    {
      "source": "/oferta/",
      "destination": "/landing.html"
    },
    {
      "source": "/vitalicio",
      "destination": "/conhecer.html"
    },
    {
      "source": "/vitalicio/",
      "destination": "/conhecer.html"
    },
    {
      "source": "/vida",
      "destination": "/landing.html"
    },
    {
      "source": "/vida/",
      "destination": "/landing.html"
    },
    {
      "source": "/vida/obrigado",
      "destination": "/vida-obrigado.html"
    },
    {
      "source": "/vida/obrigado/",
      "destination": "/vida-obrigado.html"
    },
    {
      "source": "/vendas",
      "destination": "/vendas.html"
    },
    {
      "source": "/vendas/",
      "destination": "/vendas.html"
    },
    {
      "source": "/((?!assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
