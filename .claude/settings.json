{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-deploy-check.sh",
            "timeout": 300,
            "statusMessage": "Gate de deploy: typecheck + build + testes antes do push..."
          }
        ]
      }
    ]
  }
}
